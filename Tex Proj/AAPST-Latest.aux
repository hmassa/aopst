\@writefile{toc}{\contentsline {section}{\numberline {3}Adaptive Priority Search Tree}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Comparative Performance Results}{5}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \footnotesize  A visual representation of an Access-Adaptive Priority Search Tree before any queries have been completed.}}{6}{}\protected@file@percent }
\newlabel{fig:tree}{{1}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \footnotesize  The AAPST from 1\hbox {} after it is queried for the number 5. This query required 3 comparisons to find the key, for a total operation cost of 3 comparisons.}}{6}{}\protected@file@percent }
\newlabel{fig:query1}{{2}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \footnotesize  The AAPST from 2\hbox {} after it is queried for the number 7. This query required 4 comparisons to find the key and one comparison to insert the found key and its access count as a P pair, for a total operation cost of 5 comparisons.}}{6}{}\protected@file@percent }
\newlabel{fig:query2}{{3}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \footnotesize  The AAPST from 3\hbox {} after it is queried for the number 7. This query required 3 comparisons to find the key, one comparison to delete the p pair, and one comparison to reinsert the found key and its access count as a P pair, for a total operation cost of 5 comparisons.}}{6}{}\protected@file@percent }
\newlabel{fig:query3}{{4}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \footnotesize  The AAPST from 4\hbox {} after it is queried for the number 2. This query required 3 comparisons to find the key and one comparison to attempt to insert the found key and its access count as a P pair, for a total operation cost of 4 comparisons. }}{7}{}\protected@file@percent }
\newlabel{fig:query4}{{5}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \footnotesize  The AAPST from 5\hbox {} after it is queried for the number 7. This query required 1 comparison to find the key, for a total operation cost of 1 comparison}}{7}{}\protected@file@percent }
\newlabel{fig:query5}{{6}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \footnotesize  The AAPST from 6\hbox {} after it is queried for the number 3. This query required 4 comparisons to find the key and one comparison to insert the found key and its access count as a P pair. }}{7}{}\protected@file@percent }
\newlabel{fig:query6}{{7}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \footnotesize  The AAPST from 7\hbox {} after it is queried for the number 5. This query required 3 comparisons to find the key and one comparison to attempt to reinsert the found key and its access count as a P pair. }}{7}{}\protected@file@percent }
\newlabel{fig:query7}{{8}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \footnotesize  This figure shows the average number of key comparisons for query keys drawn from uniform distribution for datasets of increasing size $n$. The expected number of key comparisons performed by the BST is $\qopname  \relax o{log}(n)$ while the splay and AAPS trees perform roughly twice as many comparisons per query.}}{9}{}\protected@file@percent }
\newlabel{fig:p-0}{{9}{9}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \footnotesize  This figure shows the average number of key comparisons when the $1/4$ of the query keys are sampled with exponential frequency and the remaining are sampled uniformly.}}{10}{}\protected@file@percent }
\newlabel{fig:p-25}{{10}{10}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \footnotesize  This figure shows the average number of key comparisons when half of the query keys are sampled with exponential frequency and the remaining half are sampled uniformly.}}{11}{}\protected@file@percent }
\newlabel{fig:p-5}{{11}{11}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \footnotesize  This figure shows the average number of key comparisons when $75\%$ of the query keys are sampled according to an exponential distribution.}}{12}{}\protected@file@percent }
\newlabel{fig:p-75}{{12}{12}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \footnotesize  This figure shows the average number of key comparisons when all query keys are sampled according to an exponential distribution, i.e., the frequency of access of different keys decreases exponentially.}}{13}{}\protected@file@percent }
\newlabel{fig:p-1}{{13}{13}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Test with Process-Completion Time Interval}{13}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \footnotesize  This figure shows the maximum number of key comparisons performed in a single query in a set of 5 million queries where $90\%$ of the query keys are sampled according to an exponential distribution}}{15}{}\protected@file@percent }
\newlabel{fig:max}{{14}{15}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \footnotesize  This figure shows the average number of key comparisons per query in a set of 5 million queries where $90\%$ of the query keys are sampled according to an exponential distribution}}{16}{}\protected@file@percent }
\newlabel{fig:avg}{{15}{16}}
